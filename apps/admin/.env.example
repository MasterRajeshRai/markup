# =================================================================
# Markup Headless CMS — Backend & Admin Environment Configuration
# =================================================================

# Database connection (Serverless PostgreSQL: Neon / Supabase / Hyperdrive)
DATABASE_URL="postgresql://username:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Security & Authentication (minimum 32-character secrets)
JWT_SECRET="markup-cms-production-jwt-secret-minimum-32-characters"
PREVIEW_SECRET="markup-cms-preview-secret-key"
COOKIE_SECRET="markup-cms-cookie-secret-salt"

# Storage Driver: cloudflare_r2 or local
STORAGE_DRIVER="cloudflare_r2"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-cloudflare-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-cloudflare-r2-secret-access-key"
R2_BUCKET_NAME="markup-media-production"
R2_PUBLIC_URL="https://media.yourdomain.com"

# Admin & API Public URLs
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
