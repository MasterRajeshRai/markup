# Database connection
DATABASE_URL="postgresql://postgres@localhost:5432/headless_cms?schema=public"

# Security, Sessions & Encryption
JWT_SECRET="enterprise-headless-cms-secret-jwt-key-minimum-32-chars"
PREVIEW_SECRET="enterprise-preview-signed-token-secret"
COOKIE_SECRET="enterprise-cookie-secret-key-salt"
# 32-byte (or 64 hex char) master encryption key for AES-256-GCM secrets (MFA, sensitive config)
SECRET_BOX_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Secret bearer token for system cron / scheduler endpoints (/api/v1/system/scheduler/run)
CRON_SECRET="generate-a-cryptographically-secure-random-cron-secret-token"

# Network & Reverse Proxy Trust
# Options: "cloudflare" (uses cf-connecting-ip), "vercel" (uses x-real-ip), "true" (right-most hop of x-forwarded-for), unset (direct)
TRUSTED_PROXY="cloudflare"
# Comma-separated list of allowed origins for cross-origin frontend sites (CORS & CSRF allowlist)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,https://princepublicschool.com"
# In production, outbound webhooks strictly require https: unless explicitly relaxed
ALLOW_INSECURE_WEBHOOKS="false"

# Storage Configuration (local | s3 | cloudflare_r2)
STORAGE_DRIVER="cloudflare_r2"
STORAGE_LOCAL_PATH="./public/uploads"
STORAGE_PUBLIC_URL="/uploads"

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="headless-cms-media"
R2_PUBLIC_URL="https://media.yourdomain.com"

# Media Auto-Crop & Processing Pipeline Tuning
MEDIA_JPEG_QUALITY="90"
MEDIA_WEBP_QUALITY="82"
MEDIA_TEMP_RETENTION_MINUTES="60"

# Optional S3 Configuration
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Application Ports & URLs
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Webhook secret key salt
WEBHOOK_SIGNING_SALT="webhook-hmac-sha256-secret-salt"

# Optional Redis for Caching / Workers / Distributed Rate Limiting
REDIS_URL=""
