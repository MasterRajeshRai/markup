{
  "name": "universal-headless-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Universal Headless CMS Platform",
  "type": "module",
  "scripts": {
    "dev:admin": "pnpm --filter @headless/admin dev",
    "dev:web": "pnpm --filter @headless/web-demo dev",
    "dev": "pnpm --filter @headless/admin dev",
    "build": "pnpm --filter @headless/database build && pnpm --filter @headless/admin build",
    "db:generate": "pnpm --filter @headless/database generate",
    "db:push": "pnpm --filter @headless/database push",
    "db:seed": "pnpm --filter @headless/database seed",
    "test": "pnpm --filter @headless/core test && pnpm --filter @headless/admin test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
